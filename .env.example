NODE_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info
JWT_SECRET=local-only-change-this-signing-secret-before-deployment
JWT_ISSUER=central-auth
# Direct INTERNAL Auth service. Never point this at the gateway or MAD facade.
AUTH_SERVICE_URL=http://localhost:5000
# Preserves existing MAD login/session/logout/password-change behavior.
MAD_SERVICE_URL=http://localhost:4000
AUTH_API_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:3000
TRUSTED_PROXIES=
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT_BYTES=1048576
RESPONSE_LIMIT_BYTES=10485760
UPSTREAM_TIMEOUT_MS=4000
AUTH_TIMEOUT_MS=2000
ROUTES_FILE=config/routes.json
# Required in production; optional for one local process.
REDIS_URL=
# Optional services: enable their entries in routes.json AFTER setting the URL.
# HW_SERVICE_URL=http://localhost:4100
# FDS_SERVICE_URL=http://localhost:4200
# FOSS_SERVICE_URL=http://localhost:4300
# KMS_SERVICE_URL=http://localhost:4500
# WKMS_SERVICE_URL=http://localhost:4600
# For optional identity routes, the target is the direct central Auth service.
# IDENTITY_SERVICE_URL=http://localhost:5000
