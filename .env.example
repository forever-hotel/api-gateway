NODE_ENV=development
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=info
# All six routes are enabled. Replace these example ports with actual service URLs.
# Check each backend's path mappings and cookie names in config/routes.json.
MAD_SERVICE_URL=http://localhost:4000
HW_SERVICE_URL=http://localhost:4100
FDS_SERVICE_URL=http://localhost:4200
FOSS_SERVICE_URL=http://localhost:4300
KMS_SERVICE_URL=http://localhost:4500
WKMS_SERVICE_URL=http://localhost:4600
# Exact frontend origins; replace these example ports with your actual origins.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:3005
TRUSTED_PROXIES=
# In-memory limits per gateway process; counters reset on restart.
RATE_LIMIT_MAX=120
LOGIN_RATE_LIMIT_MAX=10
RATE_LIMIT_WINDOW_MS=60000
BODY_LIMIT_BYTES=1048576
RESPONSE_LIMIT_BYTES=10485760
UPSTREAM_TIMEOUT_MS=4000
HEALTH_TIMEOUT_MS=2000
ROUTES_FILE=config/routes.json
# Backend cookie names must match cookieNames in routes.json.
# Browser requests using cookies must set credentials: 'include'.
