{
  "singleQuote": true,
  "trailingComma": "all",
  "overrides": [
    {
      "files": "*.{ts,tsx,js,jsx,mjs,cjs}",
      "options": {
        "tabWidth": 2,
        "useTabs": false,
        "singleQuote": true,
        "semi": true,
        "trailingComma": "none",
        "arrowParens": "avoid",
        "bracketSpacing": true,
        "printWidth": 120
      }
    }
  ]
}
